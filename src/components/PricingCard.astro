---
type Props = {
  name: string;
  price: string;
  summary: string;
  features: readonly string[];
  accent?: string;
};

const { name, price, summary, features, accent = "gold" } = Astro.props;

const currentPriceValue = Number(price.replace(/[^\d]/g, ""));
const previousPrice = Number.isFinite(currentPriceValue)
  ? `${(currentPriceValue + 3000).toLocaleString("ru-RU")} ₽`
  : undefined;
---

<article
  class:list={["pricing-card", `pricing-card--${accent}`]}
  data-parallax
  data-parallax-speed="24"
>
  <div class="pricing-card__head">
    <h3>{name}</h3>
    <div class="pricing-card__price">
      {previousPrice && <span class="pricing-card__price-old">{previousPrice}</span>}
      <strong>{price}</strong>
    </div>
  </div>
  <p>{summary}</p>
  <ul>
    {
      features.map((item) => <li>{item}</li>)
    }
  </ul>
  <div class="pricing-card__footer">
    <a
      class="button button--primary pricing-card__button"
      href="#contacts"
      data-plan-choice={name}
    >
      Записаться
    </a>
  </div>
</article>
