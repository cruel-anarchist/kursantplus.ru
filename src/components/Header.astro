---
import { contacts, navigation, siteMeta, socialChannels } from "../data/site";

const phoneHref = `tel:${contacts.phone.replace(/\s+/g, "")}`;
const emailHref = `mailto:${contacts.email}`;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <img
        src="/images/brand/logo-emblem-two-256.webp"
        alt={`Эмблема ${siteMeta.shortName}`}
        width="90"
        height="90"
        loading="eager"
      />
      <span class="brand__text">
        <strong>{siteMeta.shortName}</strong>
        <small>Автошкола категории B</small>
      </span>
    </a>

    <div class="site-header__meta" aria-label="Быстрые контакты">
      <div class="site-header__meta-contacts">
        <a
          class="site-header__meta-contact site-header__meta-contact--phone"
          href={phoneHref}
          data-speech-label={`Позвонить по номеру ${contacts.phone}`}
        >
          <img src="/images/social/phone.webp" alt="" width="18" height="18" loading="lazy" />
          <span>{contacts.phone}</span>
        </a>
        <a
          class="site-header__meta-contact site-header__meta-contact--email"
          href={emailHref}
          data-speech-label={`Написать на электронную почту ${contacts.email}`}
        >
          <img src="/images/social/email.webp" alt="" width="18" height="18" loading="lazy" />
          <span>{contacts.email}</span>
        </a>
      </div>
      <div class="site-header__meta-socials">
        <a
          class="site-header__meta-social site-header__meta-social--email"
          href={emailHref}
          data-speech-label={`Написать на электронную почту ${contacts.email}`}
        >
          <img src="/images/social/email.webp" alt="Email" width="28" height="28" loading="lazy" />
        </a>
        {
          socialChannels.map((channel) =>
            channel.href ? (
              <a
                class="site-header__meta-social"
                href={channel.href}
                target="_blank"
                rel="noreferrer"
                data-speech-label={channel.speechLabel ?? channel.label}
              >
                <img src={channel.icon} alt={channel.label} width="28" height="28" loading="lazy" />
              </a>
            ) : (
              <div class="site-header__meta-social site-header__meta-social--static" aria-label={`Канал ${channel.label}`}>
                <img src={channel.icon} alt={channel.label} width="28" height="28" loading="lazy" />
              </div>
            ),
          )
        }
      </div>
    </div>

    <button
      class="site-header__menu-toggle"
      type="button"
      data-menu-toggle
      data-speech-label="Открыть меню"
      aria-expanded="false"
      aria-controls="site-navigation"
    >
      <span></span>
      <span></span>
      <span></span>
      <strong>Меню</strong>
    </button>

    <div class="site-header__panel" data-menu-panel>
      <nav class="site-nav" id="site-navigation" aria-label="Основная навигация">
        {
          navigation.map((item) => (
            <a
              href={item.href}
              data-speech-label={item.speechLabel ?? item.label}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="site-header__actions">
        <button
          class="site-header__vision-toggle"
          type="button"
          data-vision-toggle
          aria-pressed="false"
        >
          Версия для слабовидящих
        </button>
        <a class="site-header__cta" href="#contacts">Записаться</a>
      </div>
    </div>
  </div>
</header>
