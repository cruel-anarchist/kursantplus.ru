---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contacts, siteMeta } from "../data/site";

const phoneHref = `tel:${contacts.phone.replace(/\s+/g, "")}`;
const emailHref = `mailto:${contacts.email}`;
---

<BaseLayout
  title="Курсант + | Сайт временно недоступен"
  description="На сайте автошколы Курсант + ведутся технические работы. Скоро вернёмся."
  noindex={true}
>
  <section class="maintenance-page">
    <div class="maintenance-page__ambient" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <div class="maintenance-page__shell">
      <div class="maintenance-page__content">
        <p class="maintenance-page__status">Технические работы</p>
        <h1>{siteMeta.name}</h1>
        <p class="maintenance-page__lead">
          Сайт временно недоступен: мы обновляем материалы и проверяем корректность разделов.
          Пожалуйста, свяжитесь с нами напрямую, если вопрос срочный.
        </p>

        <div class="maintenance-page__actions">
          <a class="maintenance-page__button maintenance-page__button--primary" href={phoneHref}>
            Позвонить
          </a>
          <a class="maintenance-page__button" href={emailHref}>
            Написать на почту
          </a>
        </div>
      </div>

      <aside class="maintenance-card" aria-label="Контакты автошколы">
        <div>
          <span>Телефон</span>
          <a href={phoneHref}>{contacts.phone}</a>
        </div>
        <div>
          <span>Email</span>
          <a href={emailHref}>{contacts.email}</a>
        </div>
        <div>
          <span>График</span>
          <strong>{contacts.schedule.hours}</strong>
          <p>{contacts.schedule.workdays}</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  :global(body) {
    background:
      radial-gradient(circle at 14% 12%, rgba(255, 186, 86, 0.18), transparent 28rem),
      radial-gradient(circle at 86% 20%, rgba(35, 88, 65, 0.16), transparent 30rem),
      linear-gradient(135deg, #fff7e8 0%, #f4efe4 48%, #efe2d1 100%);
  }

  .maintenance-page {
    position: relative;
    min-height: clamp(560px, 78vh, 820px);
    overflow: hidden;
    padding: clamp(4rem, 8vw, 8rem) 1.25rem;
    color: #253126;
  }

  .maintenance-page__ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .maintenance-page__ambient span {
    position: absolute;
    border: 1px solid rgba(37, 49, 38, 0.12);
    border-radius: 999px;
    transform: rotate(-12deg);
  }

  .maintenance-page__ambient span:nth-child(1) {
    width: 34rem;
    height: 12rem;
    left: -8rem;
    top: 12%;
  }

  .maintenance-page__ambient span:nth-child(2) {
    width: 28rem;
    height: 28rem;
    right: -10rem;
    top: 5%;
    background: rgba(255, 255, 255, 0.22);
  }

  .maintenance-page__ambient span:nth-child(3) {
    width: 18rem;
    height: 18rem;
    right: 16%;
    bottom: 8%;
    border-style: dashed;
  }

  .maintenance-page__shell {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    width: min(1120px, 100%);
    margin: 0 auto;
    align-items: stretch;
  }

  .maintenance-page__content,
  .maintenance-card {
    border: 1px solid rgba(37, 49, 38, 0.12);
    border-radius: 2rem;
    background: rgba(255, 252, 246, 0.78);
    box-shadow: 0 1.5rem 5rem rgba(64, 47, 31, 0.12);
    backdrop-filter: blur(16px);
  }

  .maintenance-page__content {
    padding: clamp(2rem, 5vw, 4.5rem);
  }

  .maintenance-page__status {
    width: max-content;
    margin: 0 0 1.4rem;
    border-radius: 999px;
    padding: 0.6rem 0.9rem;
    background: #253126;
    color: #fff8ec;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .maintenance-page h1 {
    max-width: 760px;
    margin: 0;
    color: #253126;
    font-size: clamp(3.3rem, 10vw, 8.5rem);
    line-height: 0.86;
    letter-spacing: -0.08em;
  }

  .maintenance-page__lead {
    max-width: 720px;
    margin: clamp(1.5rem, 3vw, 2.4rem) 0 0;
    color: #4d5b50;
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    line-height: 1.55;
  }

  .maintenance-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .maintenance-page__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.35rem;
    border: 1px solid rgba(37, 49, 38, 0.18);
    border-radius: 999px;
    padding: 0 1.35rem;
    color: #253126;
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      background 160ms ease;
  }

  .maintenance-page__button:hover,
  .maintenance-page__button:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 0.9rem 1.8rem rgba(64, 47, 31, 0.12);
  }

  .maintenance-page__button--primary {
    border-color: #d66b28;
    background: #d66b28;
    color: #fff8ec;
  }

  .maintenance-card {
    display: grid;
    align-content: end;
    gap: 1rem;
    padding: clamp(1.4rem, 3vw, 2rem);
  }

  .maintenance-card div {
    border-radius: 1.35rem;
    padding: 1.1rem;
    background: rgba(255, 255, 255, 0.62);
  }

  .maintenance-card span {
    display: block;
    margin-bottom: 0.45rem;
    color: #7a6f61;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .maintenance-card a,
  .maintenance-card strong {
    color: #253126;
    font-size: 1.18rem;
    font-weight: 850;
    text-decoration: none;
  }

  .maintenance-card p {
    margin: 0.35rem 0 0;
    color: #5c675f;
  }

  @media (max-width: 820px) {
    .maintenance-page {
      padding-block: 3rem;
    }

    .maintenance-page__shell {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .maintenance-page__content,
    .maintenance-card {
      border-radius: 1.4rem;
    }

    .maintenance-page__actions {
      flex-direction: column;
    }

    .maintenance-page__button {
      width: 100%;
    }
  }
</style>
