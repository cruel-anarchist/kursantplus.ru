---
import { siteMeta } from "../data/site";

const title = "Курсант + | Сайт временно недоступен";
const description =
  "На сайте автошколы Курсант + ведутся технические работы. Сайт временно недоступен.";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={siteMeta.themeColor} />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <main class="maintenance" aria-labelledby="maintenance-title">
      <div class="maintenance__mark" aria-hidden="true"></div>
      <section class="maintenance__card">
        <img
          class="maintenance__logo"
          src="/images/brand/logo-emblem-two-256.webp"
          alt="Логотип Курсант +"
          width="128"
          height="128"
          loading="eager"
        />
        <p class="maintenance__brand">{siteMeta.name}</p>
        <h1 id="maintenance-title">Сайт временно недоступен</h1>
        <p class="maintenance__text">
          Ведутся технические работы. Мы скоро вернём сайт в работу.
        </p>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    --navy-950: #0c1630;
    --navy-900: #14213f;
    --red-700: #b32025;
    --gold-600: #d4a63a;
    --gold-500: #e3c263;
    --ivory-50: #f6f3ec;
    --ivory-100: #efeadf;
    --white: #ffffff;
    --ink: #16171c;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    min-height: 100%;
  }

  body {
    margin: 0;
    min-width: 320px;
    color: var(--ink);
    background:
      radial-gradient(circle at 18% 18%, rgba(227, 194, 99, 0.22), transparent 24rem),
      radial-gradient(circle at 82% 18%, rgba(179, 32, 37, 0.12), transparent 22rem),
      linear-gradient(135deg, #fbfaf6 0%, var(--ivory-50) 52%, var(--ivory-100) 100%);
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
  }

  .maintenance {
    position: relative;
    display: grid;
    min-height: 100vh;
    place-items: center;
    overflow: hidden;
    padding: clamp(1.5rem, 4vw, 4rem);
  }

  .maintenance::before,
  .maintenance::after,
  .maintenance__mark {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .maintenance::before {
    inset: clamp(1rem, 3vw, 2.5rem);
    border: 1px solid rgba(12, 22, 48, 0.12);
    border-radius: clamp(1.6rem, 4vw, 3rem);
  }

  .maintenance::after {
    width: min(76vw, 760px);
    height: min(76vw, 760px);
    border: 1px solid rgba(212, 166, 58, 0.28);
    border-radius: 999px;
    background:
      linear-gradient(90deg, transparent 0 47%, rgba(179, 32, 37, 0.12) 47% 53%, transparent 53% 100%),
      linear-gradient(0deg, transparent 0 47%, rgba(20, 33, 63, 0.08) 47% 53%, transparent 53% 100%);
    opacity: 0.72;
    transform: rotate(-10deg);
  }

  .maintenance__mark {
    right: -9rem;
    bottom: -12rem;
    width: 31rem;
    height: 31rem;
    border-radius: 999px;
    background: rgba(179, 32, 37, 0.1);
    filter: blur(2px);
  }

  .maintenance__card {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    width: min(760px, 100%);
    padding: clamp(2.4rem, 7vw, 5.5rem);
    border: 1px solid rgba(12, 22, 48, 0.12);
    border-radius: clamp(1.8rem, 5vw, 3.4rem);
    background: rgba(255, 255, 255, 0.76);
    box-shadow:
      0 2rem 5.5rem rgba(12, 22, 48, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
    text-align: center;
    backdrop-filter: blur(18px);
  }

  .maintenance__logo {
    width: clamp(5.6rem, 13vw, 8rem);
    height: clamp(5.6rem, 13vw, 8rem);
    margin-bottom: clamp(1rem, 3vw, 1.6rem);
    border-radius: 1.6rem;
    filter: drop-shadow(0 1rem 1.8rem rgba(12, 22, 48, 0.18));
  }

  .maintenance__brand {
    margin: 0;
    color: var(--red-700);
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 680px;
    margin: clamp(1rem, 3vw, 1.4rem) 0 0;
    color: var(--navy-950);
    font-size: clamp(3rem, 9vw, 6.8rem);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.075em;
  }

  .maintenance__text {
    max-width: 560px;
    margin: clamp(1.35rem, 3vw, 2rem) 0 0;
    color: var(--navy-900);
    font-size: clamp(1.15rem, 2.4vw, 1.55rem);
    font-weight: 650;
    line-height: 1.45;
  }

  @media (max-width: 560px) {
    .maintenance {
      padding: 1rem;
    }

    .maintenance::before {
      inset: 0.75rem;
      border-radius: 1.25rem;
    }

    .maintenance__card {
      border-radius: 1.35rem;
    }
  }
</style>
